exports[`golden corpus — full assembled snapshots > bg-psalm1-webbe 1`] = `
{
  "blocks": [
    {
      "kind": "q",
      "verses": [
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Blessed is the man who doesn’t walk in the counsel of the wicked,",
            },
            {
              "qlevel": 2,
              "text": "nor stand on the path of sinners,",
            },
            {
              "qlevel": 2,
              "text": "nor sit in the seat of scoffers;",
            },
          ],
          "present": true,
          "verseId": "PS.1.1",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "but his delight is in the LORD’s law.",
            },
            {
              "qlevel": 2,
              "text": "On his law he meditates day and night.",
            },
          ],
          "present": true,
          "verseId": "PS.1.2",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "He will be like a tree planted by the streams of water,",
            },
            {
              "qlevel": 2,
              "text": "that produces its fruit in its season,",
            },
            {
              "qlevel": 2,
              "text": "whose leaf also does not wither.",
            },
            {
              "qlevel": 2,
              "text": "Whatever he does shall prosper.",
            },
          ],
          "present": true,
          "verseId": "PS.1.3",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "The wicked are not so,",
            },
            {
              "qlevel": 2,
              "text": "but are like the chaff which the wind drives away.",
            },
          ],
          "present": true,
          "verseId": "PS.1.4",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Therefore the wicked shall not stand in the judgement,",
            },
            {
              "qlevel": 2,
              "text": "nor sinners in the congregation of the righteous.",
            },
          ],
          "present": true,
          "verseId": "PS.1.5",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "For the LORD knows the way of the righteous,",
            },
            {
              "qlevel": 2,
              "text": "but the way of the wicked shall perish.",
            },
          ],
          "present": true,
          "verseId": "PS.1.6",
        },
      ],
    },
  ],
  "notes": [],
  "reference": "Psalm 1",
  "source": "pasted",
  "translationId": "webbe",
  "versification": "kjv",
}
`;

exports[`golden corpus — full assembled snapshots > bg-psalm23-asv 1`] = `
{
  "blocks": [
    {
      "editorial": true,
      "kind": "s1",
      "text": [
        {
          "qlevel": 0,
          "text": "A Psalm of David.",
        },
      ],
      "verses": [],
    },
    {
      "kind": "q",
      "verses": [
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Jehovah is my shepherd;",
            },
            {
              "qlevel": 2,
              "text": "I shall not want.",
            },
          ],
          "present": true,
          "verseId": "PS.23.1",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "He maketh me to lie down in green pastures;",
            },
            {
              "qlevel": 2,
              "text": "He leadeth me beside still waters.",
            },
          ],
          "present": true,
          "verseId": "PS.23.2",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "He restoreth my soul:",
            },
            {
              "qlevel": 2,
              "text": "He guideth me in the paths of righteousness for his name’s sake.",
            },
          ],
          "present": true,
          "verseId": "PS.23.3",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Yea, though I walk through the valley of the shadow of death,",
            },
            {
              "qlevel": 2,
              "text": "I will fear no evil, for thou art with me;",
            },
            {
              "qlevel": 2,
              "text": "Thy rod and thy staff, they comfort me.",
            },
          ],
          "present": true,
          "verseId": "PS.23.4",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Thou preparest a table before me in the presence of mine enemies:",
            },
            {
              "qlevel": 2,
              "text": "Thou hast anointed my head with oil;",
            },
            {
              "qlevel": 2,
              "text": "My cup runneth over.",
            },
          ],
          "present": true,
          "verseId": "PS.23.5",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Surely goodness and lovingkindness shall follow me all the days of my life,",
            },
            {
              "qlevel": 2,
              "text": "And I shall dwell in the house of Jehovah for ever.",
            },
          ],
          "present": true,
          "verseId": "PS.23.6",
        },
      ],
    },
  ],
  "notes": [],
  "reference": "Psalm 23",
  "source": "pasted",
  "translationId": "asv",
  "versification": "kjv",
}
`;

exports[`golden corpus — full assembled snapshots > bg-psalm80-webbe 1`] = `
{
  "blocks": [
    {
      "editorial": true,
      "kind": "s1",
      "text": [
        {
          "qlevel": 0,
          "text": "For the Chief Musician. To the tune of “The Lilies of the Covenant.” A Psalm by Asaph.",
        },
      ],
      "verses": [],
    },
    {
      "kind": "q",
      "verses": [
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Hear us, Shepherd of Israel,",
            },
            {
              "qlevel": 2,
              "text": "you who lead Joseph like a flock,",
            },
            {
              "qlevel": 2,
              "text": "you who sit above the cherubim, shine out.",
            },
          ],
          "present": true,
          "verseId": "PS.80.1",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Before Ephraim, Benjamin, and Manasseh, stir up your might!",
            },
            {
              "qlevel": 2,
              "text": "Come to save us!",
            },
          ],
          "present": true,
          "verseId": "PS.80.2",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Turn us again, God.",
            },
            {
              "qlevel": 2,
              "text": "Cause your face to shine,",
            },
            {
              "qlevel": 2,
              "text": "and we will be saved.",
            },
          ],
          "present": true,
          "verseId": "PS.80.3",
        },
      ],
    },
  ],
  "notes": [],
  "reference": "Psalm 80",
  "source": "pasted",
  "translationId": "webbe",
  "versification": "kjv",
}
`;
