exports[`golden corpus — full assembled snapshots > bg-luke1-birth-webbe 1`] = `
{
  "blocks": [
    {
      "editorial": true,
      "kind": "s1",
      "text": [
        {
          "qlevel": 0,
          "text": "The birth of John the Baptist",
        },
      ],
      "verses": [],
    },
    {
      "kind": "p",
      "verses": [
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "Now the time that Elizabeth should give birth was fulfilled, and she gave birth to a son.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.57",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "Her neighbours and her relatives heard that the Lord had magnified his mercy towards her, and they rejoiced with her.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.58",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "On the eighth day, they came to circumcise the child; and they would have called him Zacharias, after the name of his father.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.59",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "His mother answered, “Not so; but he will be called John.”",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.60",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "They said to her, “There is no one amongst your relatives who is called by this name.”",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.61",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "They made signs to his father, what he would have him called.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.62",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "He asked for a writing tablet, and wrote, “His name is John.”",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.63",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "His mouth was opened immediately and his tongue freed, and he spoke, blessing God.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.64",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "Fear came on all who lived around them, and all these sayings were talked about throughout all the hill country of Judea.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.65",
        },
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "All who heard them laid them up in their heart, saying, “What then will this child be?” The hand of the Lord was with him.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.66",
        },
      ],
    },
  ],
  "notes": [],
  "reference": "Luke 1:57-66",
  "source": "pasted",
  "translationId": "webbe",
  "versification": "kjv",
}
`;

exports[`golden corpus — full assembled snapshots > bg-luke1-magnificat-webbe 1`] = `
{
  "blocks": [
    {
      "editorial": true,
      "kind": "s1",
      "text": [
        {
          "qlevel": 0,
          "text": "Mary’s song",
        },
      ],
      "verses": [],
    },
    {
      "kind": "q",
      "verses": [
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "Mary said,",
            },
            {
              "qlevel": 1,
              "text": "“My soul magnifies the Lord.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.46",
        },
        {
          "fragments": [
            {
              "qlevel": 2,
              "text": "My spirit has rejoiced in God my Saviour,",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.47",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "for he has looked at the humble state of his servant.",
            },
            {
              "qlevel": 2,
              "text": "For behold, from now on, all generations will call me blessed.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.48",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "For he who is mighty has done great things for me.",
            },
            {
              "qlevel": 2,
              "text": "Holy is his name.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.49",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "His mercy is for generations and generations",
            },
            {
              "qlevel": 2,
              "text": "on those who fear him.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.50",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "He has shown strength with his arm.",
            },
            {
              "qlevel": 2,
              "text": "He has scattered the proud in the imagination of their hearts.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.51",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "He has put down princes from their thrones,",
            },
            {
              "qlevel": 2,
              "text": "and has exalted the lowly.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.52",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "He has filled the hungry with good things.",
            },
            {
              "qlevel": 2,
              "text": "He has sent the rich away empty.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.53",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "He has given help to Israel his servant,",
            },
            {
              "qlevel": 2,
              "text": "that he might remember mercy,",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.54",
        },
        {
          "fragments": [
            {
              "qlevel": 1,
              "text": "as he spoke to our fathers,",
            },
            {
              "qlevel": 2,
              "text": "to Abraham and his offspring forever.”",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.55",
        },
      ],
    },
    {
      "kind": "p",
      "verses": [
        {
          "fragments": [
            {
              "qlevel": 0,
              "text": "Mary stayed with her about three months, and then returned to her house.",
            },
          ],
          "present": true,
          "verseId": "LUKE.1.56",
        },
      ],
    },
  ],
  "notes": [],
  "reference": "Luke 1:46-56",
